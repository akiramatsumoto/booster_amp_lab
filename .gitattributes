# Small, pinned reproduction artifacts.  Keep these directly in git so the v44
# frozen AMP base and Stage3 world model are available even without git-lfs.
checkpoints/recovery_controller_v44/*.pt -filter -diff -merge -text
# walk→kick init-state dataset: shipped directly in git (not LFS) so it pushes
# to public forks and is available without git-lfs.
checkpoints/walk_states.pt -filter -diff -merge -text
# Tracked run checkpoint (logs/.../10525): shipped directly in git (not LFS) so
# it pushes to public forks, which reject new LFS objects.
logs/rsl_rl/soccer_kick_amp/10525/**/*.pt -filter -diff -merge -text
# Frozen lower-body walk policy used to build the AMP walk_policy_*.txt reference.
